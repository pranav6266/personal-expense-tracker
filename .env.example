# Copy to .env and change the values: cp .env.example .env

POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=change-me

# Base64-encoded key of at least 32 bytes. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Optional: seeds an admin account on first start when set
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Host ports
API_PORT=8080
WEB_PORT=3000
