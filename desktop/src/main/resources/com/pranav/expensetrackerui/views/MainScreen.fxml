<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.DatePicker?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pranav.expensetrackerui.controllers.MainScreenController">

    <!-- Main layout: Horizontal Box for sidebar and table -->
    <HBox spacing="20" styleClass="main-layout">

        <!-- Sidebar for actions -->
        <VBox spacing="20" styleClass="sidebar" alignment="TOP_CENTER" HBox.hgrow="NEVER">

            <!-- Sidebar Heading -->
            <Label text="Actions" styleClass="sidebar-heading"/>

            <!-- Date Picker -->
            <DatePicker fx:id="datePicker" promptText="Select Date" />

            <!-- Add Expense Button (Outlined) -->
            <MFXButton text="Add Expense" fx:id="addExpenseButton" onAction="#handleAddExpense"
                       styleClass="outlined-button" />

            <!-- View Monthly Stats Button (Outlined) -->
            <MFXButton text="View Monthly Stats" fx:id="viewMonthlyStatsButton"
                       onAction="#handleViewMonthlyStats" styleClass="outlined-button" />

            <!-- Spacer to push the logout button to the bottom -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Logout Button at bottom left corner (Solid Button) -->
            <MFXButton text="Logout" fx:id="logoutButton" onAction="#handleLogout" styleClass="solid-button" />

        </VBox>

        <!-- Expense Table -->
        <VBox spacing="20" styleClass="expense-table-container" HBox.hgrow="ALWAYS">
            <Label text="Expenses" styleClass="expenses-header" />
            <TableView fx:id="expenseTable" styleClass="expense-table">
                <columns>

                <!-- Category Column -->
                <TableColumn fx:id="categoryColumn" prefWidth="110" text="Category" />

                <!-- Description Column -->
                <TableColumn fx:id="descriptionColumn" prefWidth="210" text="Description" />

                <!-- Amount Column -->
                <TableColumn fx:id="amountColumn" prefWidth="110" text="Amount" />

                <!-- Date Column -->
                <TableColumn fx:id="dateColumn" prefWidth="100" text="Date" />

                <!-- Edit Column -->
                <TableColumn fx:id="editColumn" prefWidth="70" text="Edit" />

                <!-- Delete Column -->
                <TableColumn fx:id="deleteColumn" prefWidth="80" text="Delete" />
                </columns>
            </TableView>
        </VBox>
    </HBox>
</StackPane>
